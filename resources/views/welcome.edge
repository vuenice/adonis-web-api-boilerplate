<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  @vite(['resources/css/app.css'])
  <title>Adonis web + API</title>
</head>
<body class="stack">
  <header>
    <h1>AdonisJS web + API</h1>
    <p>One process serves HTML pages and JSON under <code>/api</code>.</p>
  </header>
  <section class="stack">
    <p><a href="/demo">Demo form</a> (CSRF token + session flash)</p>
    <p>Try <code>GET /api/health</code> for JSON.</p>
  </section>
</body>
</html>
