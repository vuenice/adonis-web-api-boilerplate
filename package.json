{
  "name": "adonis-web-api-boilerplate",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build && cp .env build/.env",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.4.2",
    "@adonisjs/core": "^6.18.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^21.0.1",
    "@adonisjs/session": "^7.7.1",
    "@adonisjs/shield": "^8.2.0",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "^4.0.0",
    "@vinejs/vine": "^3.0.1",
    "edge.js": "^6.2.1",
    "luxon": "^3.7.2",
    "mysql2": "^3.20.0",
    "pg": "^8.20.0",
    "prettier-plugin-edgejs": "^1.0.6",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/tsconfig": "^1.4.1",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^4.2.0",
    "@swc/core": "^1.11.24",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.18",
    "hot-hook": "^0.4.0",
    "oxfmt": "^0.34.0",
    "oxlint": "^1.49.0",
    "oxlint-tsgolint": "^0.22.0",
    "pino-pretty": "^13.0.0",
    "ts-node-maintained": "^10.9.6",
    "typescript": "~5.8",
    "vite": "^6.3.5"
  },
  "hotHook": {
    "boundaries": ["./app/controllers/**/*.ts", "./app/middleware/*.ts"]
  }
}
